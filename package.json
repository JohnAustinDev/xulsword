{
  "name": "xulsword",
  "productName": "MK",
  "description": "Электронная Библия",
  "type": "module",
  "scripts": {
    "dist": "electron-builder --linux snap",
    "start:app": "webpack serve --env development --env appClients",
    "start:appSrv": "webpack --env development --env appSrv --env preload && cross-env LD_LIBRARY_PATH='./Cpp/lib' electron ./build/app/dist/appSrv/server.cjs",
    "start:webapp": "webpack serve --env development --env webapp",
    "start:widgets": "webpack serve --env development --env widgets",
    "start:webappSrv": "webpack --env development --env webappSrv && cross-env LD_LIBRARY_PATH='./Cpp/lib' node ./build/webapp",
    "build:app": "yarn build:clean && webpack --env packaged --env production --env preload --env appSrv --env appClients",
    "build:webapp": "webpack --env production --env webappSrv --env webapp",
    "build:widgets": "webpack --env production --env widgets",
    "build:clean": "node ./scripts/clean.mjs dist",
    "check": "yarn pretty && yarn typescript && yarn lint && yarn lint:css",
    "pretty": "yarn prettier -w ./src",
    "typescript": "yarn tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "install-libxulsword": "node ./scripts/install-libxulsword.mjs",
    "postinstall": "electron-builder install-app-deps && yarn ./build/app && yarn ./build/webapp",
    "package": "yarn build:clean && yarn build:app && electron-builder build --publish never",
    "package-publish": "yarn build:clean && yarn build:app && electron-builder build --publish always",
    "package-linux": "cross-env PKLIB=linux yarn install-libxulsword && yarn package --linux",
    "package-32win": "cross-env PKLIB=32win yarn install-libxulsword && yarn package --win --ia32 && cross-env PKLIB=linux yarn install-libxulsword",
    "package-64win": "cross-env PKLIB=64win yarn install-libxulsword && yarn package --win --x64 '-c.nsis.artifactName=${productName} Setup 64.${version}.${ext}' -c.publish.provider=github -c.publish.channel=latest-x64 && cross-env PKLIB=linux yarn install-libxulsword",
    "package-mac": "cross-env PKLIB=darwin yarn install-libxulsword && yarn package --mac zip --x64 --arm64 && cross-env PKLIB=linux yarn install-libxulsword",
    "package-mac-dmg": "cross-env PKLIB=darwin yarn install-libxulsword && yarn package --mac dmg --universal && node ./scripts/dmgCompress.mjs",
    "package-macvm-dmg": "node ./scripts/package-macvm-dmg.mjs",
    "release": "node ./scripts/clean.mjs release && yarn release-linux && yarn release-32win && yarn release-mac",
    "release-linux": "yarn && cross-env PKLIB=linux yarn install-libxulsword && yarn package-publish --linux",
    "release-32win": "yarn && cross-env PKLIB=32win yarn install-libxulsword && yarn package-publish --win --ia32 && cross-env PKLIB=linux yarn install-libxulsword",
    "release-64win": "yarn && cross-env PKLIB=64win yarn install-libxulsword && yarn package-publish --win --x64 '-c.nsis.artifactName=${productName} Setup 64.${version}.${ext}' -c.publish.provider=github -c.publish.channel=latest-x64 && cross-env PKLIB=linux yarn install-libxulsword",
    "release-mac": "yarn && cross-env PKLIB=darwin yarn install-libxulsword && yarn package-publish --mac zip --x64 --arm64 && cross-env PKLIB=linux yarn install-libxulsword"
  },
  "build": {
    "npmRebuild": false,
    "productName": "MK",
    "appId": "org.xulsword",
    "asar": false,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json",
      "!dist/widgets*"
    ],
    "afterPack": "./afterPack.mjs",
    "directories": {
      "app": "build/app",
      "buildResources": "assets",
      "output": "build/release"
    },
    "extraResources": [
      "./assets/**",
      "!assets/dmg/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "extraFiles": [
        {
          "from": "./Cpp/lib",
          "filter": [
            "!libxulsword.node"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "type": "distribution",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "x64ArchFiles": "**/libxulsword/build/Release/*"
    },
    "dmg": {
      "background": "assets/dmg/background.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnAustinDev/xulsword.git"
  },
  "author": {
    "name": "John Austin",
    "email": "gpl.programs.info@gmail.com",
    "url": "https://github.com/JohnAustinDev/xulsword"
  },
  "contributors": [
    {
      "name": "Tom Roth"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JohnAustinDev/xulsword/issues"
  },
  "keywords": [
    "bible",
    "electron",
    "react"
  ],
  "homepage": "https://github.com/JohnAustinDev/xulsword#readme",
  "devEngines": {
    "node": ">=22.x",
    "yarn": ">=4.3.1"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "prettier": {
    "singleQuote": true
  },
  "//": "Add eslint override because eslint-plugin-react is not 'officially' compatible with 9.0.6, but is used via @eslint/compat",
  "overrides": {
    "eslint": "^9.39.5"
  },
  "dependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-react-constant-elements": "^8.0.5",
    "@babel/plugin-transform-react-inline-elements": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/runtime": "^8.0.10",
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/select": "^6.4.0",
    "@blueprintjs/table": "^6.3.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@types/express-session": "^1.19.0",
    "@types/ftp": "^0.3.36",
    "@types/gunzip-maybe": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^18.3.7",
    "@types/source-map-support": "^0.5.10",
    "@types/toobusy-js": "^0.5.4",
    "adm-zip": "^0.6.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "bufferutil": "^4.1.0",
    "chalk": "^6.0.1",
    "compression-webpack-plugin": "^12.0.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "dompurify": "^3.4.17",
    "electron": "^43.8.6",
    "electron-builder": "26.18.0",
    "electron-context-menu": "^4.1.2",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react": "^7.37.5",
    "express-session": "^1.19.0",
    "font-list": "^2.1.0",
    "ftp": "^0.3.10",
    "globals": "^17.13.0",
    "gunzip-maybe": "^1.4.2",
    "helmet": "^8.3.0",
    "html-webpack-plugin": "^5.6.8",
    "i18next": "^26.5.12",
    "i18next-fs-backend": "^2.6.9",
    "libxulsword": "portal:./libxulsword",
    "memorystore": "^1.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-dom": "^18.3.1",
    "react-refresh": "^0.19.0",
    "regenerator-runtime": "^0.14.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tar-stream": "^3.2.2",
    "toobusy-js": "^0.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "utf-8-validate": "^6.0.6",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "packageManager": "yarn@4.18.1"
}
